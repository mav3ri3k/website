---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  label: string;
}

const { src, label } = Astro.props;
---

<div class="Image">
  <div class="Image-content">
    <Image src={src} alt={label} />
    <p class="Image-label">{label}</p>
  </div>
</div>
