---
interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/posts/', label: 'Posts' },
  { href: '/dope/', label: 'Dope' },
];

const socialItems = [
  { href: 'https://github.com/mav3ri3k', label: 'GitHub' },
  { href: 'mailto:apurva.jpr@gmail.com', label: 'Mail' },
  { href: 'https://x.com/mav3ri3k', label: 'X' },
];

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<aside class="sidebar" aria-label="Site navigation">
  <div class="sidebar-profile">
    <h1 class="sidebar-title">
      <span class="sr-only">Apurva Mishra</span>
      <svg
        class="sidebar-signature"
        viewBox="0 0 480 240"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <path
          d="M26.193,92.26l1.334,-9.9c1.098,10.137 -0.83,34.67 -2.827,54.845c-1.929,19.483 -2.255,34.832 -3.321,29.367c-0.311,-1.595 4.032,-54.759 8.761,-90.945c2.734,-20.918 10.383,-36.634 25.694,-37.464c14.685,-0.796 29.853,40.454 35.297,75.265c2.966,18.966 5.539,37.551 1.648,45.417c-4.42,8.937 -9.893,2.339 -9.893,2.339"
        />
        <path
          d="M36.021,131.185c0,0 -5.915,-5.108 -3.364,-5.065c18.109,0.311 61.412,2.874 83.968,-5.538c15.504,-5.782 16.008,-24.911 18.823,-25.545c1.454,-0.327 2.28,41.653 -1.443,69.162c-3.191,23.579 -8.598,39.359 -11.692,39.821c-2.184,0.326 1.233,-6.689 7.587,-43.572c5.486,-31.844 5.545,-53.411 16.258,-64.285c6.902,-7.006 17.655,-7.537 25.249,-0.915c7.731,6.742 11.377,25.092 11.244,34.179c-0.262,17.932 -13.057,28.841 -33.731,25.897"
        />
        <path
          d="M185.312,139.47c0,0 0.227,18.882 9.196,18.651c18.918,-0.486 34.288,-60.263 27.325,-61.88c-4.846,-1.125 -7.58,60.609 6.133,62.403c17.967,2.351 22.996,-53.201 25.933,-53.343c2.676,-0.129 -1.868,55.509 11.334,53.601c14.813,-2.141 28.629,-59.43 14.663,-66.571c-3.728,-1.907 -10.59,5.938 -4.319,11.392c6.501,5.653 24.057,3.857 27.747,0.517c7.316,-6.621 -0.87,50.028 11.062,54.541c10.237,3.872 16.54,-40.497 19.089,-53.615c1.079,-5.554 4.693,53.576 17.188,52.74c10.086,-0.675 18.24,-26.929 16.535,-49.29c-0.72,-9.444 -12.17,-18.258 -15.667,-13.429c-8.331,11.502 17.947,11.765 35.603,9.526"
        />
        <path
          d="M416.224,132.418c11.688,-8.58 4.509,-34.859 -4.892,-35.581c-26.844,-2.061 -41.732,55.45 -27.275,59.634c28.127,8.141 36.326,-28.369 40.495,-32.482c0.226,-0.223 8.358,29.938 37.927,33.085"
        />
      </svg>
    </h1>
    <p class="sidebar-subtitle">Executing on 10% year over year improvement</p>
  </div>

  <nav class="sidebar-nav" aria-label="Main navigation">
    {navItems.map((item) => (
      <a
        href={item.href}
        class:list={['sidebar-nav-link', { active: isActive(item.href) }]}
      >
        {item.label}
      </a>
    ))}
  </nav>

  <nav class="sidebar-social" aria-label="Social links">
    {socialItems.map((item) => (
      <a
        href={item.href}
        class="sidebar-social-link"
        target="_blank"
        rel="noopener noreferrer"
        title={item.label}
      >
        {item.label}
      </a>
    ))}
  </nav>
</aside>

<script>
  import { initSidebarSignatures } from '../scripts/signature';

  initSidebarSignatures();
</script>
