---
import Base from '../layouts/Base.astro';
import BaseHead from '../components/BaseHead.astro';
import { SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Home" description={SITE_DESCRIPTION} image={undefined} />
	</head>
	<body>
		<Base pageTitle="Home">
			<article>
				<h1>Apurva Mishra</h1>
				<p>
					I build ML systems at the compiler–model boundary.
				</p>
				<p>
					Currently deep in ML systems + compiler workflows.
					Thinking a lot about eval correctness, data quality, and reproducible training loops.
				  If you’re working on ML systems or LLM infra, I’d love to collaborate.
				</p>
				<h2>Selected Works</h2>
				<ul class="post-list">
					<li class="post-item">
						<time class="post-date" datetime="2024-10-07">October 7, 2024</time>
						<a href="https://summerofcode.withgoogle.com/archive/2024/projects/kXG0mZoj" class="post-link">Google Summer of Code in Rust Compiler</a>
						<p>Add experimental support to Rust compiler for running procedural macros in WebAssembly.</p>
					</li>
					<li class="post-item">
						<time class="post-date" datetime="2025-12-03">December 3, 2025</time>
						<a href="https://github.com/mav3ri3k/jax-models" class="post-link">JAX Models</a>
						<p>Hand-written JAX models across language, vision, and chess experiments.</p>
						<p>
							[ <a href="https://github.com/mav3ri3k/jax-models">Code</a> ]
							[ <a href="https://colab.research.google.com/drive/1knhMolrlt2-UHq4J5W1VV3dpiCFKZXSG">Colab (LLM Demo)</a> ]
							[ <a href="https://colab.research.google.com/drive/1A0M4ituAViVedqs8YU0WWUomBrc4wTjD">Colab (ViT Demo)</a> ]
							[ <a href="https://static.apurva-mishra.com/Playing_Video_Games_using_DL_Models.pdf">Technical Report (Chess EBM Model)</a> ]
						</p>
					</li>
					<li class="post-item">
						<time class="post-date" datetime="2025-01-01">January 1, 2025</time>
						<a href="https://github.com/mav3ri3k/typ-browser" class="post-link">typ-browser</a>
						<p>A simple browser made using SwiftUI and Rust. It uses Typst as the document format instead of HTML.</p>
					</li>
				</ul>
				<h2>News</h2>
				<ul class="post-list">
					<li class="post-item">
						<time class="post-date">December 5, 2025</time>
						<p><strong>ML Intern at IIT Hyderabad</strong></p>
						<p>At IIT Hyderabad, I am building and iterating on a vulnerability-detection training pipeline, focusing on evaluation reliability and synthetic-data strategy.</p>
					</li>
					<li class="post-item">
						<time class="post-date">October 7, 2024</time>
						<p>Completed Google Summer of Code on the topic <a href="https://summerofcode.withgoogle.com/archive/2024/projects/kXG0mZoj">Sandboxed and Deterministic Proc Macro using Wasm</a> in the Rust compiler</p>
					</li>
				</ul>
			</article>
		</Base>
	</body>
</html>
