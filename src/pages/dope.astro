---
import Base from '../layouts/Base.astro';
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import Image from '../components/Image.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Dope" description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Base pageTitle="Dope">
			<article>
				<h1>Dope</h1>
				<Image src="/src/assets/keyboard.png" label="121 WPM @ 60 seconds" />
				<Image src="/src/assets/dog.jpg" label="Travel guide at Tiger's Nest Trek, Bhutan" />
				<Image src="/src/assets/blender.png" label="Blender Render" />
				<Image src="/src/assets/racing.jpg" label="No. 1 in the World" />
				<Image src="/src/assets/reaction.png" label="In-Human!" />
			</article>
		</Base>
	</body>
</html>
